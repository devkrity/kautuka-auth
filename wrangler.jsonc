{
  "name": "kautuka-auth",
  "compatibility_date": "2026-10-09",
  "main": "./worker-entry.js",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "DPOP_STATE", "class_name": "DpopState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DpopState"] }]
}
