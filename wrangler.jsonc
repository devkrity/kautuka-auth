{
  "name": "kautuka-auth",
  "compatibility_date": "2026-10-09",
  "main": "./dist/worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      // Registered Google sign-in key thumbprints. The binding name is what the token function reads.
      "binding": "GOOGLE_MAIL_KEYS",
      "id": "e3081a8eef574c1b8dfe64e80ace9353"
    }
  ]
}
